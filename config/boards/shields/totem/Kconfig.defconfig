if SHIELD_TOTEM_DONGLE

config ZMK_KEYBOARD_NAME
    default "TOTEM Dongle"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_USB
	default y

endif

if SHIELD_TOTEM_DONGLE_NN

config ZMK_KEYBOARD_NAME
    default "TOTEM Dongle"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_USB
	default y

config ZMK_SPLIT
    default y

config ZMK_BLE
	default y

endif

if SHIELD_TOTEM_BTLEFT

config ZMK_KEYBOARD_NAME
    default "TOTEM"
    
config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_USB
	default y

endif

if SHIELD_TOTEM_LEFT || SHIELD_TOTEM_RIGHT || SHIELD_TOTEM_DONGLE

config ZMK_SPLIT
    default y

config ZMK_BLE
	default y

endif

if SHIELD_TOTEM_BTLEFT || SHIELD_TOTEM_BTRIGHT

config ZMK_SPLIT
    default y

config ZMK_BLE
	default y

endif

# Enable the I2C bus and the SSD1306 OLED driver whenever a display build is
# selected (only the `totem_dongle dongle_display` combo sets ZMK_DISPLAY). On
# this ZMK's Zephyr the driver is not auto-enabled by the devicetree node alone,
# so mirror ZMK's own OLED shields (microdox, lily58, ...) and turn it on here.
if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY
