if SHIELD_TOTEM_DONGLE

config ZMK_KEYBOARD_NAME
    default "TOTEM Dongle"
    
config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_USB
	default y

endif

if SHIELD_TOTEM_BTLEFT

config ZMK_KEYBOARD_NAME
    default "TOTEM"
    
config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_USB
	default y

endif

if SHIELD_TOTEM_LEFT || SHIELD_TOTEM_RIGHT || SHIELD_TOTEM_DONGLE

config ZMK_SPLIT
    default y

config ZMK_BLE
	default y

endif

if SHIELD_TOTEM_BTLEFT || SHIELD_TOTEM_BTRIGHT

config ZMK_SPLIT
    default y

config ZMK_BLE
	default y

endif

# Compatibility shim for englmaxi/zmk-dongle-display.
#
# The module still gates its battery widget on the old CONFIG_ZMK_BATTERY symbol,
# but current ZMK renamed that to CONFIG_ZMK_BATTERY_REPORTING. Without this the
# left/right peripheral battery widget silently compiles out. Alias the old name
# to the new one so the battery levels are shown. Harmless once the module updates.
config ZMK_BATTERY
    bool
    default y if ZMK_BATTERY_REPORTING && SHIELD_DONGLE_DISPLAY
